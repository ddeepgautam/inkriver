APP_ENV=production
APP_ORIGIN=https://example.com
APP_SECRET=replace-with-at-least-32-random-characters
# Set only when managed hosting forces a separate public-only document root.
# PUBLIC_DOCUMENT_ROOT=/absolute/path/to/public_html
PRIVATE_STORAGE_PATH=/absolute/path/outside-your-web-root/inkriver-private
DATABASE_PATH=/absolute/path/outside-your-web-root/inkriver-private/database/inkriver.sqlite
SESSION_DAYS=30
CRON_SECRET=replace-with-an-independent-random-secret
PAYMENT_CURRENCY_RATES_JSON={"INR":1,"USD":0.012,"EUR":0.011,"GBP":0.0095,"AED":0.044,"SGD":0.015,"AUD":0.018,"CAD":0.016}
