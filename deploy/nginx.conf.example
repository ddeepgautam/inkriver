server {
    listen 443 ssl http2;
    server_name your-domain.example;
    root /var/www/inkriver/public;
    index index.php;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    location ^~ /src/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /dist/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /sw.js {
        try_files $uri =404;
        expires -1;
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /index.html {
        rewrite ^ /index.php last;
    }

    location ^~ /.well-known/ {
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location ~ \.php(?:/|$) {
        return 404;
    }

    location ~ /\. {
        deny all;
    }

    location ^~ /uploads/support/ {
        return 404;
    }

    location ~* ^/uploads/.*\.(?:php[0-9]*|phtml|phar|cgi|pl|py|rb|sh|bash|exe|dll|so|htaccess)$ {
        return 404;
    }

    # Configure TLS certificates, logs, request-size limits, rate limits, and
    # trusted proxy handling for your environment. Redirect HTTP to HTTPS.
}
